{
  "network": "atlantic-testnet",
  "executor": "0xb1Ee3cC528fa525b304562549b7716429a0937d5",
  "rules": {
    "spendLimit": {
      "maxGasPerTx": 300000,
      "maxCostPerTxWei": "1000000000000000",
      "perAddressDaily": { "maxTx": 1, "maxGasWei": "1000000000000000" },
      "globalDaily": { "maxGasWei": "50000000000000000" }
    },
    "allowlist": {
      "contracts": [
        {
          "address": "0xAdB97503ad3A8BDA288C0c179818052b2b301638",
          "label": "DeskGuestbook check-in",
          "methods": ["checkIn(string)"]
        },
        {
          "address": "0xAdB97503ad3A8BDA288C0c179818052b2b301638",
          "label": "DeskGuestbook motto (weekend campaign only)",
          "methods": ["setMotto(string)"],
          "timeWindow": { "id": "weekend-campaign", "timezone": "Asia/Jakarta", "days": ["Sat", "Sun"] }
        }
      ],
      "senders": { "deny": ["0xE5EE78a15A86912df2be98b8F69CC0e932a50Bc4"] },
      "allowValue": false
    },
    "timeWindow": {
      "id": "desk-hours",
      "timezone": "Asia/Jakarta",
      "days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
      "start": "06:00",
      "end": "23:00",
      "blackouts": [
        { "start": "2026-12-31T22:00:00+07:00", "end": "2027-01-01T02:00:00+07:00", "reason": "new-year maintenance freeze" }
      ]
    }
  },
  "maxCallsPerRequest": 4,
  "maxDeadlineSec": 3600,
  "heuristics": {
    "newAddressWindowSec": 600,
    "maxNewAddressesPerWindow": 5,
    "freshNonceThreshold": 1,
    "burstWindowSec": 60,
    "maxRequestsPerBurst": 3,
    "failureWindowSec": 86400,
    "maxFailures": 3
  }
}
